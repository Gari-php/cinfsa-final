# Copiar este archivo como .env y completar con los valores reales.
# El archivo .env NUNCA debe subirse a git (ya está en .gitignore).

# Entorno: development (muestra errores en pantalla) o production (los oculta y los guarda en logs/php_errors.log)
APP_ENV=development

# URL pública del sitio (se usa en los enlaces de los emails de confirmación y recuperación)
APP_URL=http://localhost

# Base de datos
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=cinfsa1

# Emails
# Solo si MAIL_DRIVER=sendgrid
SENDGRID_API_KEY=
# Remitente: tiene que estar verificado en el proveedor (Brevo: Senders, Domains & Dedicated IPs → Senders)
MAIL_FROM=
MAIL_FROM_NAME="CINFSA Cinema"
# Casilla que recibe reclamos de soporte y mensajes de contacto
MAIL_SOPORTE=cinecinfsa@gmail.com

# Proveedor de envío: smtp (Brevo u otro servidor SMTP) o sendgrid
MAIL_DRIVER=smtp
# Brevo: Settings (SMTP & API) → pestaña SMTP. SMTP_USER es el "Login" (no tu email) y
# SMTP_PASSWORD una "SMTP key" generada ahí (no la contraseña de la cuenta)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# MercadoPago
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_SUCCESS_URL=http://localhost/pago/exitoso
MP_FAILURE_URL=http://localhost/pago/fallido
MP_PENDING_URL=http://localhost/pago/pendiente
MP_NOTIFICATION_URL=http://localhost/webhook/mercadopago

# Pusher (notificaciones en tiempo real)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=us2
