# Copiar este archivo como .env y completar con los valores reales.
# El archivo .env NUNCA debe subirse a git (ya está en .gitignore).

# URL pública del sitio (se usa en los enlaces de los emails de confirmación y recuperación)
APP_URL=http://localhost

# Base de datos
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=cinfsa1

# SendGrid (envío de emails)
SENDGRID_API_KEY=

# MercadoPago
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_SUCCESS_URL=http://localhost/pago/exitoso
MP_FAILURE_URL=http://localhost/pago/fallido
MP_PENDING_URL=http://localhost/pago/pendiente
MP_NOTIFICATION_URL=http://localhost/webhook/mercadopago

# Pusher (notificaciones en tiempo real)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=us2
